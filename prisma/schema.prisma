generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String     @id @default(cuid())
  name              String
  email             String     @unique
  password          String
  role              Role       @default(STUDENT)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  createdActivities Activity[] @relation("CreatedBy")
  createdModules    Module[]   @relation("ModuleCreatedBy")
  studentProgress   Progress[]
}

model Module {
  id          String   @id @default(cuid())
  title       String
  createdAt   DateTime @default(now())
  createdById String
  description String
  isActive    Boolean  @default(true)
  order       Int
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation("ModuleCreatedBy", fields: [createdById], references: [id])
  topics      Topic[]
}

model Topic {
  id         String     @id @default(cuid())
  title      String
  content    String
  order      Int
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  moduleId   String
  activities Activity[]
  module     Module     @relation(fields: [moduleId], references: [id])
}

model Activity {
  id          String          @id @default(cuid())
  title       String
  type        ActivityType
  difficulty  DifficultyLevel @default(BEGINNER)
  config      Json
  points      Int             @default(10)
  timeLimit   Int?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  topicId     String
  createdById String
  createdBy   User            @relation("CreatedBy", fields: [createdById], references: [id])
  topic       Topic           @relation(fields: [topicId], references: [id])
  progress    Progress[]
}

model Progress {
  id          String    @id @default(cuid())
  score       Int       @default(0)
  completed   Boolean   @default(false)
  timeSpent   Int?
  attempts    Int       @default(0)
  lastAttempt DateTime?
  feedback    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  studentId   String
  activityId  String
  activity    Activity  @relation(fields: [activityId], references: [id])
  student     User      @relation(fields: [studentId], references: [id])

  @@unique([studentId, activityId])
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String
}

model Resource {
  id        String       @id @default(cuid())
  title     String
  type      ResourceType
  url       String?
  content   String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum ActivityType {
  WORD_SEARCH
  QUIZ
  MATCHING
  EXERCISE
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ResourceType {
  DOCUMENT
  VIDEO
  LINK
  IMAGE
}
